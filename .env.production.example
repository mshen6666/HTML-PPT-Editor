PORT=8787
PPT_INVITE_CODE=helloWorld
# Use a long random value in production. If omitted, the app generates a temporary
# secret on startup and existing invite sessions are invalidated after restart.
PPT_INVITE_COOKIE_SECRET=replace-with-a-long-random-cookie-secret

ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_AUTH_TOKEN=replace-with-your-minimax-key
ANTHROPIC_MODEL=MiniMax-M2.7
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
PPT_JOB_TIMEOUT_MS=3000000
API_TIMEOUT_MS=3000000

PPT_SANDBOX_ROOT=/data/ppt/runtime/sandboxes
PPT_ARTIFACT_ROOT=/data/ppt/runtime/artifacts
PPT_UPLOAD_ROOT=/data/ppt/runtime/uploads
